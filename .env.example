# ── Database ───────────────────────────────────────────────────────────────────
# Default: uses the MongoDB container included in docker-compose
MONGO_URI=mongodb://mongo:27017/privatejet
# For MongoDB Atlas, replace the line above with:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/privatejet

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE=30d

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5000

# ── Email ──────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_FROM=PrivateJet <noreply@privatejet.com>

# ── Aviapages API ──────────────────────────────────────────────────────────────
AVIAPAGES_API_KEY=your-aviapages-api-key
